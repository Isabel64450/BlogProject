{% extends 'base.html.twig' %}

{% block title %}New Category{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100 flex items-center justify-center py-10">

    <div class="w-full max-w-lg bg-white p-8 rounded-2xl shadow-lg">

        <h1 class="text-2xl font-bold mb-6 text-center">
            ➕ Nouvelle Catégorie
        </h1>

        {{ include('category/_form.html.twig', { button_label: 'Créer' }) }}

        <div class="mt-4 text-center">
            <a href="{{ path('app_category') }}"
               class="text-blue-500 hover:underline">
                ← Retour à la liste
            </a>
        </div>

    </div>

</div>
{% endblock %}