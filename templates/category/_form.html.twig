<div class="space-y-4">

    {{ form_start(form) }}

        <div>
            {{ form_label(form.name, null, {'label_attr': {'class': 'block text-gray-700 mb-1'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-400'}}) }}
            {{ form_errors(form.name) }}
        </div>

        <div>
            {{ form_label(form.color, null, {'label_attr': {'class': 'block text-gray-700 mb-1'}}) }}
            {{ form_widget(form.color, {'attr': {'class': 'w-full h-10 border rounded-lg'}}) }}
            {{ form_errors(form.color) }}
        </div>

        <button class="w-full bg-blue-500 text-white py-2 rounded-lg hover:bg-blue-600 transition">
            {{ button_label|default('Save') }}
        </button>

    {{ form_end(form) }}

</div>