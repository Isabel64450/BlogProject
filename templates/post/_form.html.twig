<div class="space-y-4">

    {{ form_start(form) }}

        <div>
            {{ form_label(form.title, null, {'label_attr': {'class': 'block text-gray-700 mb-1'}}) }}
            {{ form_widget(form.title, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-400'}}) }}
            {{ form_errors(form.title) }}
        </div>

        <div>
            {{ form_label(form.content, null, {'label_attr': {'class': 'block text-gray-700 mb-1'}}) }}
            {{ form_widget(form.content, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg h-40 focus:ring-2 focus:ring-blue-400'}}) }}
            {{ form_errors(form.content) }}
        </div>

        <div>
            {{ form_label(form.category, null, {'label_attr': {'class': 'block text-gray-700 mb-1'}}) }}
            {{ form_widget(form.category, {'attr': {'class': 'w-full px-4 py-2 border rounded-lg'}}) }}
            {{ form_errors(form.category) }}
        </div>

        <div class="flex items-center">
            {{ form_widget(form.published, {'attr': {'class': 'mr-2'}}) }}
            {{ form_label(form.published) }}
        </div>

        <button class="w-full bg-blue-500 text-white py-2 rounded-lg hover:bg-blue-600 transition">
            {{ button_label|default('Save') }}
        </button>

    {{ form_end(form) }}

</div>