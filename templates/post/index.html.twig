{% extends 'base.html.twig' %}

{% block title %}Articles{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100 py-10">

    <div class="container mx-auto px-4">

        <div class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold text-gray-800">
                 Derniers Articles
            </h1>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_post_new') }}"
                   class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition">
                    + Nouvel article
                </a>
            {% endif %}
        </div>

        {% if posts is empty %}
            <div class="bg-white p-6 rounded-xl shadow text-center text-gray-600">
                Aucun article disponible.
            </div>
        {% else %}

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

                {% for post in posts %}

                    <div class="bg-white rounded-2xl shadow hover:shadow-lg transition p-6 flex flex-col">

                        <h2 class="text-xl font-semibold text-gray-800 mb-2">
                            {{ post.title }}
                        </h2>

                        <p class="text-sm text-gray-500 mb-2">
                             {{ post.createdAt ? post.createdAt|date('d/m/Y') : '' }}
                        </p>

                        <p class="text-gray-600 mb-4 line-clamp-3">
                            {{ post.content|slice(0, 120) }}...
                        </p>

                        <div class="mt-auto flex justify-between items-center">

                            <span class="text-sm bg-gray-200 px-3 py-1 rounded-full">
                                {{ post.category.name }}
                            </span>

                            <a href="#"
                               class="text-blue-500 hover:underline text-sm">
                                Lire plus →
                            </a>

                        </div>

                        {% if is_granted('ROLE_ADMIN') %}
                            <div class="mt-4 flex gap-2">
                                <a href="{{ path('app_post_edit', {'id': post.id}) }}"
                                   class="text-sm text-yellow-600 hover:underline">
                                    Modifier
                                </a>
                            </div>
                        {% endif %}

                    </div>

                {% endfor %}

            </div>

        {% endif %}

    </div>

</div>
{% endblock %}