{% extends 'base.html.twig' %}

{% block title %}New Post{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100 flex items-center justify-center py-10">

    <div class="w-full max-w-2xl bg-white p-8 rounded-2xl shadow-lg">

        <h1 class="text-2xl font-bold mb-6 text-center">
             Create New Article
        </h1>

        {{ include('post/_form.html.twig', { button_label: 'Create' }) }}

        <div class="mt-4 text-center">
            <a href="{{ path('app_my_posts') }}" class="text-blue-500 hover:underline">
                 Back to list
            </a>
        </div>

    </div>

</div>
{% endblock %}