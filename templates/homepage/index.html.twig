{% extends 'base.html.twig' %}

{% block title %}Accueil - Mon Blog{% endblock %}

{% block body %}

<div class="min-h-screen bg-gray-50">

   
    <section class="bg-white shadow-sm">
        <div class="max-w-6xl mx-auto px-6 py-16 text-center">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-6">
                welcome to our blogs
            </h1>
            <p class="text-lg text-gray-600 mb-8">
                Discover articles, tips and news about web development, tech and more.
            </p>

            <form class="max-w-xl mx-auto flex" action="{{ path('homepage_search') }}" method="get">
                <input type="text" name="q" placeholder="search an article..."
                 class="w-full px-4 py-3 border rounded-l-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                  <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-r-lg hover:bg-blue-700 transition">Search</button>
            </form>
        </div>
    </section>

    
    <section class="max-w-6xl mx-auto px-6 py-16">
        <h2 class="text-2xl font-bold text-gray-800 mb-8">
            Lastest articles
        </h2>

        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">

    {% for post in posts %}

        <article class="bg-white rounded-xl shadow hover:shadow-lg transition overflow-hidden">
            <div class="p-6">

                <h3 class="text-xl font-semibold mb-3">
                    {{ post.title }}
                </h3>

                <p class="text-gray-600 mb-4">
                    {{ post.content|slice(0, 120) }}...
                </p>

                <a href=" {{ path('app_post_show', {id: post.id}) }} "
                   class="text-blue-600 font-medium hover:underline">
                    Read more →
                </a>

            </div>
        </article>

    {% else %}

        <p class="text-gray-500">
            Not article found.
        </p>

    {% endfor %}

</div>
    </section>

   
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-8">
            Catégories
        </h2>

        <div class="flex flex-wrap gap-4">
            {% for category in categories %}
                <a href="{{ path('homepage_category', {id: category.id}) }}"
                   class="px-4 py-2 rounded-full font-semibold text-white shadow-sm 
                          hover:brightness-110 transition duration-200 cursor-pointer
                          {% if selectedCategory is defined and selectedCategory.id == category.id %}ring-4 ring-black/50{% endif %}"
                   style="background-color: {{ category.color }}">
                    {{ category.name }}
                </a>
            {% endfor %}
        </div>
    </div>
</section>
</div>

{% endblock %}